# GitHub Integration
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_WEBHOOK_SECRET=your-webhook-secret-change-in-production

# LLM Provider
ANTHROPIC_API_KEY=sk-ant-your-key-here

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://auditor:changeme@postgres:5432/iac_auditor
POSTGRES_DB=iac_auditor
POSTGRES_USER=auditor
POSTGRES_PASSWORD=changeme

# Redis (Celery broker + result backend)
REDIS_URL=redis://redis:6379/0

# Audit settings
AUDIT_BRANCH_PREFIX=security/auto-fix/

# Observability
LOG_LEVEL=INFO
